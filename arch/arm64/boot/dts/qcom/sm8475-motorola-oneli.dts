/*
 * Motorola razr 2022 (oneli), minimal native Linux board description.
 *
 * Source: MotorolaMobilityLLC/kernel-devicetree
 * 90fa7be1db5bd47202673d4431408659149a7359
 * qcom/cape-moto-oneli-base.dts and qcom/cape-oneli-pvt-overlay.dts.
 *
 * [INFERRED] The upstream board compatible uses "motorola,oneli" in
 * place of Motorola's downstream "moto,oneli" property.
 */

/dts-v1/;

#include "sm8475.dtsi"
#include "pm8350.dtsi"
#include "pm8350b.dtsi"
#include "pm8350c.dtsi"
#include "pm8450.dtsi"
#include "pmk8350.dtsi"
#include "pmr735a.dtsi"

/*
 * Motorola's oneli base remaps ADSP to 0x85700000 and video to
 * 0x9fd00000. The inherited SM8450 RMTFS carveout conflicts with
 * oneli's video reservation, so do not publish it until the live
 * firmware's RMTFS address is known.
 */
/delete-node/ &adsp_mem;
/delete-node/ &video_mem;
/delete-node/ &rmtfs_mem;

/ {
	model = "Motorola razr 2022";
	compatible = "motorola,oneli", "qcom,sm8475";
	chassis-type = "handset";

	aliases {
		serial0 = &uart7;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	reserved-memory {
		adsp_mem: memory@85700000 {
			reg = <0x0 0x85700000 0x0 0x2800000>;
			no-map;
		};

		video_mem: memory@9fd00000 {
			reg = <0x0 0x9fd00000 0x0 0x700000>;
			no-map;
		};
	};
};

/*
 * [INFERRED] Review-only RPMh rail reconstruction for Motorola oneli.
 *
 * Rail resource names, UFS consumers and initial voltage settings are
 * extracted from Motorola Cape DT at 90fa7be1db5bd47202673d4431408659149a7359.
 * RPMh PMIC IDs and upstream node representation match the SM8450 HDK
 * comparator; upstream parent input supplies are not proven for oneli.
 *
 * Keep the provider devices disabled until the parent supply topology
 * and bootloader/firmware regulator ownership are verified. This must
 * not drive any rail in the present bring-up DT.
 */
&apps_rsc {
	regulators-0 {
		compatible = "qcom,pm8350-rpmh-regulators";
		qcom,pmic-id = "b";
		status = "disabled";

		oneli_l5b: ldo5 {
			regulator-name = "oneli-l5b-ufs-phy";
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <880000>;
		};

		oneli_l7b: ldo7 {
			regulator-name = "oneli-l7b-ufs-vcc";
			regulator-min-microvolt = <2504000>;
			regulator-max-microvolt = <2504000>;
		};

		oneli_l9b: ldo9 {
			regulator-name = "oneli-l9b-ufs-vccq";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
		};
	};

	regulators-1 {
		compatible = "qcom,pm8350c-rpmh-regulators";
		qcom,pmic-id = "c";
		status = "disabled";

		oneli_l10c: ldo10 {
			regulator-name = "oneli-l10c-ufs-pll";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
		};
	};
};

/* UFS is still disabled. The supply phandles are review-only. */
&ufs_mem_hc {
	vcc-supply = <&oneli_l7b>;
	vccq-supply = <&oneli_l9b>;
};

&ufs_mem_phy {
	vdda-phy-supply = <&oneli_l5b>;
	vdda-pll-supply = <&oneli_l10c>;
};

/*
 * The GENI QUP wrapper is disabled in the inherited SM8450 tree.
 * An enabled UART child cannot probe through a disabled parent.
 */
&qupv3_id_0 {
	status = "okay";
};

/*
 * Motorola's Cape DTS selected serial@99c000 for diagnostic output.
 * UART7 belongs to QUP wrapper 0. Correct the inherited UART7
 * interconnect votes (which incorrectly refer to wrapper 2) locally.
 * Its existing GCC WRAP0_S7 clock and TLMM gpio26/27 pinctrl states
 * are consistent with Motorola's Cape pinmux definition.
 *
 * [INFERRED] The UART signals are accessible on the retail board;
 * this cannot be established without the handset.
 */
&uart7 {
	interconnects = <&clk_virt MASTER_QUP_CORE_0 QCOM_ICC_TAG_ALWAYS
				&clk_virt SLAVE_QUP_CORE_0 QCOM_ICC_TAG_ALWAYS>,
			<&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ALWAYS
				&config_noc SLAVE_QUP_0 QCOM_ICC_TAG_ALWAYS>;
	status = "okay";
};
