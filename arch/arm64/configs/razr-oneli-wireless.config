# SPDX-License-Identifier: GPL-2.0-only
#
# Development-only WCN6855 PCIe Wi-Fi / GENI UART Bluetooth fragment.
# Oneli wireless board nodes, PMU and parent RPMh providers are disabled.
# This does NOT enable the radios or change the accepted native boot image.
#
# Deliberate dependencies: PCI root/PHY and common pwrseq core are built-in;
# radio drivers and PMU sequencing stay modules for a future userspace image.
# Kconfig resolves symbols: see BOOT unified DT validation artifact.
CONFIG_REGULATOR=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_POWER_SEQUENCING=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=m
CONFIG_PCIE_QCOM=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_PCI_PWRCTRL_GENERIC=y
CONFIG_PCI_PWRCTRL_PWRSEQ=m
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_MHI_BUS=m
CONFIG_QRTR=m
CONFIG_QRTR_MHI=m
CONFIG_BT=m
CONFIG_BT_LE=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_QCA=m
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
