# SPDX-License-Identifier: GPL-2.0-only
#
# Development-only WCN6855 PCIe Wi-Fi / GENI UART Bluetooth fragment.
# Radio nodes/parents are enabled for source/build integration only.
# This does not promote an accepted boot Image or imply hardware operation.
#
# Boot-critical PCI pre-power path is built in: RPMh, QMP PHY, WCN pwrseq,
# PCI pre-power and PCI root. ath11k and Bluetooth remain modules.
# Kconfig resolves symbols: see BOOT unified DT validation artifact.
CONFIG_FW_LOADER=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_POWER_SEQUENCING=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=y
CONFIG_PCIE_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_PCI_PWRCTRL_GENERIC=y
CONFIG_PCI_PWRCTRL_PWRSEQ=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_MHI_BUS=m
CONFIG_QRTR=m
CONFIG_QRTR_MHI=m
CONFIG_BT=m
CONFIG_BT_LE=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_QCA=m
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
